  "mcpServers": {
    "agentville": {
      "command": "uvx",
      "args": [
        "--python", "3.15",
        "--from", "git+https://github.com/minhphamdonhat/agentville@652451affe0ae0f2f5bb565faf629beca4f3f2dc#subdirectory=agentville",
        "agentville", "engine", "mcp"
      ],
      "env": {
        "AGENTVILLE_ROOT": "${CLAUDE_PROJECT_DIR}",
        "CLAUDE_PROJECT_DIR": "${CLAUDE_PROJECT_DIR}"
      }
    }
  }
}
